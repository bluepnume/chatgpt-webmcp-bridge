{
    "extends": "cugel-scripts/tsconfig/browser.json",
    "compilerOptions": {
        "rootDir": "./",
        "types": [
            "node",
            "vitest/globals"
        ]
    },
    "include": [
        "src/**/*.ts",
        "test/**/*.ts",
        "scripts/**/*.ts"
    ],
    "exclude": [
